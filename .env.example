APP_NAME=PromptEdit Studio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
# Keep the main log quiet in production (warning); mail has its own channel.
LOG_LEVEL=debug
MAIL_LOG_CHANNEL=mail

DB_CONNECTION=sqlite
# PostgreSQL example (production):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=promptedit_prod
# DB_USERNAME=promptedit_app
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# Pixelforge (image generation provider)
# ---------------------------------------------------------------------------
PIXELFORGE_BASE_URL=https://pixelforge.promptedit.dev/v1
# Create an API key in the Pixelforge dashboard; each key has its own
# webhook URL, signing secret and usage report. Use one key per environment.
PIXELFORGE_API_KEY=
PIXELFORGE_WEBHOOK_SECRET=
# Customer charge = actual provider cost x markup (exact bcmath math).
PIXELFORGE_MARKUP=1.25
# Minutes to cache the live GET /pricing payload (a persisted last-known-good
# snapshot in the database is the degraded fallback).
PIXELFORGE_PRICING_CACHE_MINUTES=15

# ---------------------------------------------------------------------------
# Admin seeding (used ONCE by `php artisan db:seed` at deploy time — the
# values are never committed; leave empty to skip the seed)
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Administrator
